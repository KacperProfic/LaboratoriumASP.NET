@model WebApp.Models.OrganizationModel

@{
    ViewBag.Title = "Edytuj organizacje";
    Layout = "_Layout";
}

<h2>Edytuj</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label class="form-label" asp-for="Name"></label>
        <input class="form-control" asp-for="Name" />
        <span class="text-danger" asp-validation-for="Name"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="NIP"></label>
        <input class="form-control" asp-for="NIP" />
        <span class="text-danger" asp-validation-for="NIP"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="REGON"></label>
        <input class="form-control" asp-for="REGON" />
        <span class="text-danger" asp-validation-for="REGON"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Address.City"></label>
        <input class="form-control" asp-for="Address.City" />
        <span class="text-danger" asp-validation-for="Address.City"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="Address.Street"></label>
        <input class="form-control" asp-for="Address.Street" />
        <span class="text-danger" asp-validation-for="Address.Street"></span>
    </div>
    <button class="btn btn-outline-primary" type="submit">Zapisz</button>
</form>