@model WebApp.Models.OrganizationModel

@{
    ViewBag.Title = "Szczegóły";
    Layout = "_Layout";
}

<h2>Szczegoły</h2>
<div class="card">
    <div class="card-header">
        Szczegóły
    </div>
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
    </div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item">NIP: @Model.NIP</li>
        <li class="list-group-item">REGON: @Model.REGON</li>
        <li class="list-group-item">Miasto: @Model.Address?.City</li>
        <li class="list-group-item">Ulica: @Model.Address?.Street</li>
    </ul>
    <div class="card-body">
        <a class="btn btn-primary" asp-action="Index">Powrót do listy</a>
    </div>
</div>