@model IEnumerable<WebApp.Models.OrganizationModel>

@{
    ViewBag.Title = "Organizacje";
    Layout = "_Layout";
}

<h2>Organizacje</h2>
<a class="btn btn-primary" asp-action="Create">Dodaj organizacje</a>
<h4>Lista</h4>

@if (Model.Any())
{
    <table class="table">
        <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.First().Name)</th>
            <th>@Html.DisplayNameFor(model => model.First().NIP)</th>
            <th>@Html.DisplayNameFor(model => model.First().REGON)</th>
            <th>Akcje</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var organization in Model)
        {
            <tr>
                <td>@organization.Name</td>
                <td>@organization.NIP</td>
                <td>@organization.REGON</td>
                <td>
                    <a class="btn btn-success" asp-action="Edit" asp-route-id="@organization.Id">Edycja</a>
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@organization.Id">Szczegóły</a>
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@organization.Id">Usuń</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
else
{
    <h3 class="text-danger">brak dostępnych organizacji</h3>
}